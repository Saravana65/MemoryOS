# Application Settings
PROJECT_NAME="MemoryOS Backend"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_secure_random_key_for_jwt_tokens"
ACCESS_TOKEN_EXPIRE_MINUTES=115200

# PostgreSQL Database Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=memoryos
# For docker-compose, use: postgresql://postgres:postgres@db:5432/memoryos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memoryos

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB Settings
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME=memoryos_documents

# MinIO / S3 Object Storage Settings
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=memoryos-documents

# LLM & Embedding Settings
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
